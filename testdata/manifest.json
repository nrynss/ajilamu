  "segments": [
    {
      "id": 1,
      "start_ms": 5908,
      "end_ms": 7728,
      "duration_ms": 1820,
      "text": "Hi, I'm Suni Williams",
      "speaker": "Suni Williams",
      "emotion": "Warm"
    },
    {
      "id": 2,
      "start_ms": 7728,
      "end_ms": 13208,
      "duration_ms": 5480,
      "text": "and I'm an astronaut who's lived and worked aboard the International Space Station.",
      "speaker": "Suni Williams",
      "emotion": "Explanatory"
    },
    {
      "id": 3,
      "start_ms": 13208,
      "end_ms": 18528,
      "duration_ms": 5320,
      "text": "An amazing research laboratory that's orbiting the Earth about 250 miles above us.",
      "speaker": "Suni Williams",
      "emotion": "Explanatory"
    },
    {
      "id": 4,
      "start_ms": 18818,
      "end_ms": 24478,
      "duration_ms": 5660,
      "text": "While we're at the space station, we astronauts live and work in a microgravity environment.",
      "speaker": "Suni Williams",
      "emotion": "Explanatory"
    },
    {
      "id": 5,
      "start_ms": 24788,
      "end_ms": 29628,
      "duration_ms": 4840,
      "text": "Do you think the laws of physics will hold up in the space station while experiencing microgravity?",
      "speaker": "Suni Williams",
      "emotion": "Questioning"
    },
    {
      "id": 6,
      "start_ms": 30348,
      "end_ms": 34978,
      "duration_ms": 4630,
      "text": "Let's check with NASA astronaut Mark Van der High on the International Space Station to find out.",
      "speaker": "Suni Williams",
      "emotion": "Enthusiastic"
    },
    {
      "id": 7,
      "start_ms": 38271,
      "end_ms": 45311,
      "duration_ms": 7040,
      "text": "Newton's first law of motion says an object at rest tends to stay at rest unless acted on by an outside force.",
      "speaker": "Mark Vande Hei",
      "emotion": "Explanatory"
    },
    {
      "id": 8,
      "start_ms": 47381,
      "end_ms": 54491,
      "duration_ms": 7110,
      "text": "Also, an object in motion tends to stay in motion unless acted on by an outside force.",
      "speaker": "Mark Vande Hei",
      "emotion": "Explanatory"
    }
  ],
