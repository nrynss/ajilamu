# Local development only. Copy to .env and fill it in.
#
# The deployed host never reads this file. Secrets live in Google Secret Manager
# and non-secrets live in the systemd unit. See dev-diary/infrastructure.md,
# "Configuration and Secrets", for the inventory and the injection path.
#
# Never commit a real value here. Names and safe defaults only.

# Server settings.
PORT=8080
ENV=development

# Google Cloud and Gemini settings.
# Authenticate with ADC. The SDK reads DetectDefault. Do not set an API key.
# GOOGLE_APPLICATION_CREDENTIALS is for developer machines that already hold a
# key file. The deployed host leaves it unset and uses the attached service account.
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# ClickHouse Cloud database settings.
# CLICKHOUSE_PASSWORD is a secret. In production it comes from Secret Manager.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# ClickHouse MCP settings. The agent reads the ledger through the local server.
# CLICKHOUSE_READONLY_PASSWORD and CLICKHOUSE_MCP_AUTH_TOKEN are secrets.
# The server defaults to stdio, so the transport must be set explicitly.
# Host validation rejects every request whose Host is not in the allow list.
CLICKHOUSE_MCP_URL=http://127.0.0.1:8000/mcp
CLICKHOUSE_MCP_SERVER_TRANSPORT=http
CLICKHOUSE_MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000
CLICKHOUSE_MCP_AUTH_TOKEN=
CLICKHOUSE_READONLY_PASSWORD=

# ClickHouse Cloud OpenAPI settings. Both values are secrets.
CLICKHOUSE_KEY_ID=
CLICKHOUSE_KEY_SECRET=
CLICKHOUSE_SERVICE_ID=
CLICKHOUSE_ORG_ID=

# Application paths. AJILAMU_DATA_DIR holds uploads and the durable ledger queue.
# AJILAMU_FRONTEND_DIR names the built Svelte output. AJILAMU_SAMPLE_CLIP overrides
# the committed NASA clip that sample mode copies.
AJILAMU_DATA_DIR=data
AJILAMU_FRONTEND_DIR=web/build
AJILAMU_SAMPLE_CLIP=
