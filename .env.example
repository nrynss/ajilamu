# Google Cloud & Gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=nryn-personal
GOOGLE_CLOUD_LOCATION=us-central1

# ClickHouse Cloud
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# Server
PORT=8080
ENV=development
