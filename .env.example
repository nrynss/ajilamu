# Server settings.
PORT=8080
ENV=development

# Google Cloud and Gemini settings.
# Authenticate with ADC. The SDK reads DetectDefault. Do not set an API key.
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# ClickHouse Cloud database settings.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# ClickHouse MCP settings. The agent reads the ledger through the local server.
CLICKHOUSE_MCP_URL=http://127.0.0.1:8000/mcp
CLICKHOUSE_MCP_AUTH_TOKEN=

# ClickHouse Cloud OpenAPI settings.
CLICKHOUSE_KEY_ID=
CLICKHOUSE_KEY_SECRET=
CLICKHOUSE_SERVICE_ID=
CLICKHOUSE_ORG_ID=
